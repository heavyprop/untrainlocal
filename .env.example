# Copy to .env. Values match compose.yaml; these credentials are LOCAL ONLY.
DJANGO_SECRET_KEY=development-only-replace-for-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DATABASE_URL=postgresql://untrainable:development@127.0.0.1:5433/untrainable
REDIS_URL=redis://127.0.0.1:6380/1
SEARCH_URL=http://127.0.0.1:8081/search
HOSTING_STORAGE_ROOT=private_hosting

# Generate locally: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SEARCH_SERVICE_TOKEN=
